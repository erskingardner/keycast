# The domain you want to use for Keycast
# Remember to set your DNS records!
DOMAIN=your-domain.com

# Comma-separated 64-character hex pubkeys trusted to operate this instance.
# The signer fails closed when this is empty.
ALLOWED_PUBKEYS=hexpubkey1,hexpubkey2
# Operators can change global relays. Use an external signer for all management approvals.
KEYCAST_OPERATOR_PUBKEYS=hexpubkey1

# Separate production images keep the root credential out of the API and web images.
KEYCAST_API_IMAGE=ghcr.io/marmot-protocol/keycast-api
KEYCAST_SIGNER_IMAGE=ghcr.io/marmot-protocol/keycast-signer
KEYCAST_WEB_IMAGE=ghcr.io/marmot-protocol/keycast-web
# Set these to reviewed sha256 digests for production Compose; source builds need none.
KEYCAST_API_DIGEST=
KEYCAST_SIGNER_DIGEST=
KEYCAST_WEB_DIGEST=
